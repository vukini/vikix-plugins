#!/usr/bin/env python3
"""inbox — notes from anywhere, into your Org inbox.

  inbox note           a small box over what you're doing (Super+Alt+i):
                       write, or press Super+F9 and speak; C-c C-c keeps it,
                       C-c C-k drops it
  inbox quote          the same, with what you've selected quoted in it
                       (Super+Alt+Shift+i)
  inbox add TEXT...    a note straight from a terminal or a script (TEXT, or
                       stdin when there's none); --source SAYS where it came
                       from, --url ADDRESS the page
  inbox sort           file the inbox's notes where they belong, a model
                       suggesting, you choosing, and to-dos to Todoist
                       (Super+Alt+Shift+s, or the menu: in a terminal)
  inbox sort --undo    put back the files as they were before the last sort
  inbox sync           your notes up to Dropbox: starts it if it isn't
                       running, takes the notes folder back in if this
                       laptop's sync left it out, and waits until it's up
                       to date (notes-sync is the same; --notify for a
                       notification too)
  inbox open           the inbox in Emacs
  inbox file           where the inbox is

Each note is an Org heading: the first line is its title, the rest its
body, with when it was written and where from (the window you were in) as
properties, and for a page in Firefox or Nyxt its address. The box is an Emacs frame through org-capture when Emacs's
server runs (Vikix starts it); without it, a one-line rofi box.
Settings: ~/.config/vikix/plugins/inbox/settings (file =).
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import pageaddress  # noqa: E402

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
SETTINGS = os.path.join(CONFIG, "vikix", "plugins", "inbox", "settings")
EL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "inbox.el")
FRAME = "Note to inbox"   # the frame's title: plugin.lisp floats the window by it
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]


def inbox_file():
    path = "~/Dropbox/notes/inbox.org"
    try:
        with open(SETTINGS) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.split("=", 1)
                    if k.strip() == "file" and v.strip():
                        path = v.strip()
    except FileNotFoundError:
        pass
    return os.path.abspath(os.path.expanduser(path))


def run(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def source():
    """Where the note comes from: the window you were in, by its title and
    its program (WM_CLASS's second word), and for a browser the page's
    address when it can be found (lib/pageaddress.py)."""
    win = run(["xdotool", "getactivewindow"])
    if not win:
        return "", ""
    title = run(["xdotool", "getwindowname", win])
    cls = run(["xprop", "-id", win, "WM_CLASS"]).rsplit('"', 2)
    program = cls[-2] if len(cls) >= 3 else ""
    src = f"{title} ({program})" if title and program and program.lower() not in title.lower() else title or program
    return src, pageaddress.address(program, title)


def stamp(t=None):
    t = time.localtime(t)
    return time.strftime(f"[%Y-%m-%d {DAYS[t.tm_wday]} %H:%M]", t)


def entry(text, src="", quote="", url=""):
    """An Org heading: the first line the title, the rest the body."""
    lines = text.strip("\n").splitlines() or [""]
    title = lines[0].strip() or "Note"
    props = [":PROPERTIES:", f":CREATED:  {stamp()}"]
    if src:
        props.append(f":SOURCE:   {' '.join(src.split())}")
    if url:
        props.append(f":URL:      {url}")
    props.append(":END:")
    # A body line starting with * would be a heading of its own: Org's escape.
    body = [("," + l if l.lstrip(",").startswith("*") else l) for l in lines[1:]]
    out = [f"* {title}", *props, *body]
    if quote.strip():
        out += ["#+begin_quote", *[("," + l if l.lstrip(",").startswith(("*", "#+")) else l)
                                    for l in quote.strip("\n").splitlines()], "#+end_quote"]
    return "\n".join(out) + "\n"


def append(text, src="", quote="", url=""):
    path = inbox_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    new = not os.path.exists(path) or os.path.getsize(path) == 0
    with open(path, "a") as f:
        if new:
            f.write("#+title: Inbox\n\n")
        else:
            with open(path, "rb") as r:
                r.seek(-1, os.SEEK_END)
                if r.read(1) != b"\n":
                    f.write("\n")
        f.write(entry(text, src, quote, url))
    return path


def notify(text):
    run(["notify-send", "-a", "inbox", "-t", "3000", text])


def emacs_box(src, quote, url):
    """The box in Emacs, through org-capture; False when Emacs's server isn't there."""
    if not shutil.which("emacsclient"):
        return False
    fd, ask = tempfile.mkstemp(prefix="inbox-", suffix=".json", dir=os.environ.get("XDG_RUNTIME_DIR"))
    with os.fdopen(fd, "w") as f:
        json.dump({"file": inbox_file(), "source": src, "url": url, "quote": quote, "created": stamp()}, f)
    el = os.path.realpath(EL)
    form = f'(progn (load {json.dumps(el)} nil t) (vikix-inbox-capture {json.dumps(ask)}))'
    try:
        r = subprocess.run(["emacsclient", "-c", "-n", "-F", f'((name . "{FRAME}") (width . 80) (height . 14) (menu-bar-lines . 0) (tool-bar-lines . 0) (vertical-scroll-bars . nil))',
                            "-e", form], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        r = None
    if r is None or r.returncode != 0:
        try:
            os.unlink(ask)
        except OSError:
            pass
        return False
    return True


def rofi_box(src, quote, url):
    try:
        text = subprocess.run(["rofi", "-dmenu", "-p", "note", "-l", "0",
                               "-mesg", (f"Into the inbox · from {src}" if src else "Into the inbox")],
                              input="", capture_output=True, text=True).stdout.strip()
    except OSError:
        return
    if text:
        append(text, src, quote, url)
        notify("Noted in the inbox")


def box(with_quote):
    src, url = source()
    quote = run(["xclip", "-o", "-selection", "primary"]) if with_quote else ""
    if not emacs_box(src, quote, url):
        rofi_box(src, quote, url)


def dropbox(*args, timeout=10):
    try:
        r = subprocess.run(["dropbox", *args], capture_output=True, text=True, timeout=timeout)
        return (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def sync(notify_too):
    """Your notes up to Dropbox: start it if it isn't running, make sure the
    notes folder isn't left out, and wait until it says up to date."""
    def say(text):
        print(text, flush=True)
        if notify_too:
            notify(text)
    if not shutil.which("dropbox"):
        sys.exit("inbox sync: Dropbox isn't installed (vikix add dropbox)")
    folder = os.path.dirname(inbox_file())
    home_dropbox = os.path.join(HOME, "Dropbox") + os.sep
    if not (folder + os.sep).startswith(home_dropbox):
        sys.exit(f"inbox sync: the notes ({folder}) aren't in ~/Dropbox")
    if "isn't running" in dropbox("status"):
        say("Starting Dropbox…")
        dropbox("start", timeout=60)
    # The top folder under ~/Dropbox: that's what selective sync leaves out.
    top = os.path.join(HOME, "Dropbox", os.path.relpath(folder, home_dropbox).split(os.sep)[0])
    started, last = time.time(), ""
    while True:
        excluded = dropbox("exclude", "list")
        if "isn't responding" not in excluded and excluded:
            break
        if time.time() - started > 600:
            sys.exit("inbox sync: Dropbox didn't answer in 10 minutes (dropbox status says why)")
        time.sleep(3)
    if any(os.path.join(HOME, line.strip()) == top for line in excluded.splitlines()):
        say(f"{top} was left out of this laptop's sync: taking it back in")
        dropbox("exclude", "remove", top)
    while True:
        state = dropbox("filestatus", folder).rsplit(":", 1)[-1].strip()
        if state == "up to date":
            say("Your notes are up to date in Dropbox.")
            return
        now = dropbox("status").splitlines()[0] if dropbox("status") else "waiting for Dropbox"
        if now != last:
            print(f"  {now}", flush=True)
            last = now
        time.sleep(3)


def main(argv):
    cmd = argv[0] if argv else "note"
    if cmd == "note":
        box(False)
    elif cmd == "quote":
        box(True)
    elif cmd == "add":
        args, src, url = argv[1:], "", ""
        while args[:1] in (["--source"], ["--url"]) and len(args) >= 2:
            if args[0] == "--source":
                src = args[1]
            else:
                url = args[1]
            args = args[2:]
        text = " ".join(args) if args else sys.stdin.read()
        if not text.strip():
            sys.exit("inbox add: nothing to note")
        print(append(text, src, "", url))
    elif cmd == "sort" and argv[1:] == ["--term"]:
        # From the key or the menu: in Vikix's terminal (StumpWM passes
        # VIKIX_TERMINAL), which stays open to read what it did.
        term = (os.environ.get("VIKIX_TERMINAL") or "alacritty").split()
        script = f'"{sys.executable}" "{os.path.realpath(__file__)}" sort; echo; echo "(Enter closes this)"; read _'
        argv2 = term + ([] if os.path.basename(term[0]) == "kitty" else ["-e"]) + ["sh", "-c", script]
        subprocess.Popen(["setsid", "-f", *argv2], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif cmd == "sort":
        os.execvp(sys.executable, [sys.executable, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                                                "..", "lib", "sort.py"), *argv[1:]])
    elif cmd == "sync":
        try:
            sync("--notify" in argv)
        except KeyboardInterrupt:
            print("\nStopped waiting; Dropbox carries on by itself.")
    elif cmd == "open":
        path = inbox_file()
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write("#+title: Inbox\n\n")
        os.execvp("emacsclient", ["emacsclient", "-c", "-n", path])
    elif cmd == "file":
        print(inbox_file())
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("-h", "--help", "help") else 2)


if __name__ == "__main__":
    main(sys.argv[1:])
