#!/bin/sh
# inbox's own test (tests/check.sh runs it): inbox add writes an Org
# heading (first line the title, the rest the body, * lines escaped, when
# and where from), makes the file and its folder, and keeps to the
# settings; without Emacs's server the box is rofi's, and an empty answer
# notes nothing; the Emacs box (in a batch Emacs, when there is one) keeps a
# note with its source and the quote, and C-c C-k leaves nothing.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
export HOME="$t" XDG_CONFIG_HOME="$t/config" XDG_RUNTIME_DIR="$t/run"
mkdir -p "$t/config/vikix/plugins/inbox" "$t/run" "$t/bin"
inbox="$t/notes/inbox.org"
echo "file = $inbox" > "$t/config/vikix/plugins/inbox/settings"
fail=0
ok() { if "$@"; then :; else echo "FAIL: $*"; fail=1; fi; }

ok test "$("$here/bin/inbox" file)" = "$inbox"
printf 'Buy stamps\n* not a heading\n' | "$here/bin/inbox" add --source "a terminal" >/dev/null
ok grep -qx '#+title: Inbox' "$inbox"
ok grep -qx '\* Buy stamps' "$inbox"
ok grep -qx ',\* not a heading' "$inbox"
ok grep -qx ':SOURCE:   a terminal' "$inbox"
ok grep -qE '^:CREATED:  \[[0-9]{4}-[0-9]{2}-[0-9]{2} [A-Z][a-z]{2} [0-9]{2}:[0-9]{2}\]$' "$inbox"
if "$here/bin/inbox" add "" 2>/dev/null; then echo "FAIL: an empty note was added"; fail=1; fi

# No Emacs server: rofi's box (a stand-in that answers, then one that doesn't).
printf '#!/bin/sh\nexit 1\n' > "$t/bin/emacsclient"
printf '#!/bin/sh\necho "Ring the bank"\n' > "$t/bin/rofi"
printf '#!/bin/sh\nexit 0\n' > "$t/bin/notify-send"
printf '#!/bin/sh\nexit 1\n' > "$t/bin/xdotool"
chmod +x "$t/bin/"*
PATH="$t/bin:$PATH" "$here/bin/inbox" note
ok grep -qx '\* Ring the bank' "$inbox"
printf '#!/bin/sh\nexit 1\n' > "$t/bin/rofi"
before=$(wc -l < "$inbox")
PATH="$t/bin:$PATH" "$here/bin/inbox" note
ok test "$(wc -l < "$inbox")" = "$before"
ok test -z "$(ls "$t/run")"           # the box's file doesn't stay behind

# The Emacs box, in a batch Emacs.
if command -v emacs >/dev/null; then
  box() {   # box TEXT FINISH [ELISP]: what bin/inbox hands Emacs, then typing and C-c C-c or C-c C-k
    printf '{"file": "%s", "source": "Board review (Teams)", "url": "https://example.org/board", "quote": "#+ a line\\nsecond", "created": "[2026-10-02 Fri 21:00]"}' "$inbox" > "$t/run/ask.json"
    emacs --batch -Q -l "$here/lib/inbox.el" --eval "(progn ${3:-} (vikix-inbox-capture \"$t/run/ask.json\") (insert \"$1\") ($2))" 2>/dev/null
  }
  box 'Follow up with Lee\nabout the budget' org-capture-finalize
  ok grep -qx '\* Follow up with Lee' "$inbox"
  ok grep -q -A4 'Follow up with Lee' "$inbox"
  ok grep -qx ':SOURCE:   Board review (Teams)' "$inbox"
  ok grep -qx ':URL:      https://example.org/board' "$inbox"
  ok grep -qx ',#+ a line' "$inbox"
  ok grep -qx 'about the budget' "$inbox"
  ok test ! -e "$t/run/ask.json"
  # A config that opens every file read-only (as Vid's does): the note
  # still lands, saved, and no buffer of the inbox is left open.
  box 'Read only is fine' "progn (org-capture-finalize) (princ (length (seq-filter (function buffer-file-name) (buffer-list))))" \
    "(add-hook 'find-file-hook (lambda () (read-only-mode 1)))" > "$t/left"
  ok grep -qx '\* Read only is fine' "$inbox"
  ok test "$(cat "$t/left")" = 0
  before=$(cat "$inbox")
  box 'Never mind' org-capture-kill
  ok test "$(cat "$inbox")" = "$before"
  box '' org-capture-finalize          # nothing written but the quote: a title anyway
  ok grep -qx '\* Note' "$inbox"
fi

# inbox sync, with a stand-in Dropbox: not running (started), the notes
# folder left out (taken back), syncing twice, then up to date.
mkdir -p "$t/dbx" "$t/Dropbox/notes"
echo "file = $t/Dropbox/notes/inbox.org" > "$t/config/vikix/plugins/inbox/settings"
cat > "$t/bin/dropbox" <<SH
#!/bin/sh
d=$t/dbx
echo "\$*" >> \$d/calls
case "\$1" in
  status) if [ -e \$d/running ]; then echo "Syncing 3 files"; else echo "Dropbox isn't running!"; fi ;;
  start) touch \$d/running ;;
  exclude) if [ "\$2" = list ]; then echo "Excluded:"; [ -e \$d/back ] || echo "Dropbox/notes"; else touch \$d/back; fi ;;
  filestatus) n=\$(cat \$d/n 2>/dev/null || echo 0); echo \$((n+1)) > \$d/n
              if [ "\$n" -ge 2 ]; then echo "\$2: up to date"; else echo "\$2: syncing"; fi ;;
esac
SH
chmod +x "$t/bin/dropbox"
out=$(PATH="$t/bin:$here/bin:$PATH" timeout 60 "$here/bin/notes-sync")
ok grep -q '^start$' "$t/dbx/calls"
ok grep -qx "exclude remove $t/Dropbox/notes" "$t/dbx/calls"
case $out in *"up to date in Dropbox"*) ;; *) echo "FAIL: notes-sync said: $out"; fail=1 ;; esac
echo "file = $inbox" > "$t/config/vikix/plugins/inbox/settings"

# A page's address; the sort, its undo, and Todoist (test-sort.py).
"$here/bin/inbox" add --url https://docs.voidlinux.org/ "Read about runit" >/dev/null
ok grep -qx ':URL:      https://docs.voidlinux.org/' "$inbox"
rm -rf "$t/notes"
python3 "$here/test-sort.py" || fail=1

[ "$fail" = 0 ] && echo "inbox: add, the rofi box, the Emacs box (kept, dropped, untitled), the page's address, sort, undo, Todoist"
exit "$fail"
