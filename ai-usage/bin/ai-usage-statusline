#!/bin/sh
# ai-usage-statusline — Claude Code's status line (the plugin's setup sets
# it). Claude Code hands it, on every refresh, what it knows: with a Pro or
# Max plan, after its first answer, rate_limits (the 5-hour window, the
# week, an extra-usage limit: a percentage and when each resets). This
# notes them in ~/.local/state/vikix/ai-usage for the bar, then prints the
# line Claude Code shows under its prompt: your own status line's, when
# you had one (setup kept it), or a short one of its own.
#
#   ai-usage-statusline   read what Claude Code hands it on stdin (JSON),
#                         print the status line; it takes no arguments

state="${XDG_STATE_HOME:-$HOME/.local/state}/vikix/ai-usage"
own="${XDG_CONFIG_HOME:-$HOME/.config}/vikix/plugins/ai-usage/your-statusline"
input=$(cat)

here=$(dirname "$(readlink -f "$0")")
printf '%s' "$input" | python3 "$here/../lib/note.py" "$state" 2>/dev/null

if [ -s "$own" ]; then
  printf '%s' "$input" | sh -c "$(cat "$own")"
else
  awk '$1 == "five_hour" { f = $2 } $1 == "seven_day" { w = $2 }
       END { if (f != "" || w != "") printf "plan %s%s%s", (f != "" ? f "% 5h" : ""), (f != "" && w != "" ? " · " : ""), (w != "" ? w "% week" : "") }' "$state" 2>/dev/null
fi
