#!/bin/sh
# agent-waiting's own test (tests/check.sh runs it). The hook command: a
# permission dialog is noted at once with the tool and what it's for, a
# question with its words; the notification that follows seconds later
# doesn't write the note again, an idle one neither; a finished turn is
# "reply" with the line when it ends on a question or leaves a step that
# starts "You:", else "done" with its first line, and takes the place of
# an "ask"; one that stops with work in the background leaves no note
# unless it asks; each note has the folder; the desktop is told each time
# (a made-up vikix here); outside a terminal window nothing happens. Codex's
# notify payload: a turn's end is done or reply as Claude's is, an approval
# or a question asks, anything else is nothing. setup adds the five hooks
# once, keeping what was there, and Codex's notify setting before its first
# table, once, never over one of your own; remove takes only them out.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
export HOME="$t" XDG_STATE_HOME="$t/state"
unset WINDOWID
# A vikix of the test's own: what the desktop is told lands in a file.
mkdir -p "$t/bin"
printf '#!/bin/sh\necho "$*" >> "%s/told"\n' "$t" > "$t/bin/vikix"
chmod +x "$t/bin/vikix"
PATH="$t/bin:$PATH"; export PATH
fail=0
ok() { if "$@"; then :; else echo "FAIL: $*"; fail=1; fi; }
aw() { printf '%s' "${2:-{\}}" | ALACRITTY_WINDOW_ID=${3:-42} "$here/bin/agent-waiting" "$1"; }
state() { sed -n 1p "$t/state/vikix/agents/${1:-42}" 2>/dev/null | cut -d' ' -f1; }
stamp() { sed -n 1p "$t/state/vikix/agents/${1:-42}" 2>/dev/null | cut -d' ' -f2; }
folder() { sed -n 2p "$t/state/vikix/agents/${1:-42}" 2>/dev/null; }
line() { sed -n 3p "$t/state/vikix/agents/${1:-42}" 2>/dev/null; }

# A permission dialog: at once, with the tool and what it is for.
aw permission '{"cwd": "/home/me/src/esploro", "tool_name": "Bash", "tool_input": {"command": "make install", "description": "Install the build"}}'
ok test "$(state)" = ask
ok test "$(folder)" = esploro
ok test "$(line)" = "Bash: Install the build"
# The notification seconds later says less: the note stays as it is.
aw ask '{"message": "Claude needs your permission to use Bash", "notification_type": "permission_prompt"}'
ok test "$(line)" = "Bash: Install the build"
# The turn's end takes the place of an ask, and its first line is kept.
aw "done" '{"cwd": "/home/me/src/esploro", "last_assistant_message": "## Installed\n\nThe build is **installed** in `~/.local`.\n\nNothing is left to do."}'
ok test "$(state)" = "done"
ok test "$(line)" = "Installed"
# An idle "waiting for your input", a minute later, changes nothing.
before=$(cat "$t/state/vikix/agents/42")
aw ask '{"message": "Claude is waiting for your input", "notification_type": "idle_prompt"}'
ok test "$(cat "$t/state/vikix/agents/42")" = "$before"
aw clear
ok test ! -e "$t/state/vikix/agents/42"

# It ends on a question: reply, with the question.
aw "done" '{"cwd": "/x/vikix", "last_assistant_message": "The tests pass.\n\n```sh\nls?\n```\n\nShall I **merge** it now?"}'
ok test "$(state)" = reply
ok test "$(line)" = "Shall I merge it now?"
# It leaves you a step: reply, with the step.
aw "done" '{"cwd": "/x/vikix", "last_assistant_message": "Fixed and released.\n\nLive on your desktop: NO\n- You: run `gup`.\n- Me: nothing."}' 43
ok test "$(state 43)" = reply
ok test "$(line 43)" = "You: run gup."
# A word like "your" at the start of a line isn't a step for you.
aw "done" '{"last_assistant_message": "Your tests: all passed."}' 44
ok test "$(state 44)" = "done"
# Work still running in the background: not done, no note; a question is one.
aw "done" '{"last_assistant_message": "The tests are running.", "background_tasks": [{"id": "b1"}]}' 45
ok test ! -e "$t/state/vikix/agents/45"
aw "done" '{"last_assistant_message": "The tests are running. Which branch next?", "background_tasks": [{"id": "b1"}]}' 45
ok test "$(state 45)" = reply
# AskUserQuestion: its question.
aw question '{"tool_name": "AskUserQuestion", "tool_input": {"questions": [{"question": "Which library should we use?", "options": []}]}}' 46
ok test "$(state 46)" = ask
ok test "$(line 46)" = "Which library should we use?"
# With no note yet, the notification makes one: asking, or (idle) done.
aw ask '{"message": "Claude needs your permission to use Edit"}' 47
ok test "$(state 47) $(line 47)" = "ask Claude needs your permission to use Edit"
aw ask '{"message": "Claude is waiting for your input"}' 48
ok test "$(state 48)" = "done"
# A very long line is cut, and what isn't JSON is no reason to fail.
aw "done" "{\"last_assistant_message\": \"$(printf 'word %.0s' $(seq 1 100))\"}" 49
ok test "$(line 49 | wc -m)" -le 242
aw "done" 'not json' 50
ok test "$(state 50)" = "done"
# Codex's notify: a turn's end, with its hyphenated keys; an approval; a
# question; a kind it doesn't know.
aw codex '{"type": "agent-turn-complete", "cwd": "/x/office", "thread-id": "t1", "last-assistant-message": "The build is **done**.\n\nShall I push it?"}' 51
ok test "$(state 51) $(folder 51) $(line 51)" = "reply office Shall I push it?"
aw codex '{"type": "agent-turn-complete", "last-assistant-message": "Built."}' 51
ok test "$(state 51) $(line 51)" = "done Built."
aw codex '{"type": "approval-requested", "cwd": "/x/office"}' 52
ok test "$(state 52) $(line 52)" = "ask wants your yes"
aw codex '{"type": "async-question", "message": "Which **branch**?"}' 53
ok test "$(state 53) $(line 53)" = "ask Which branch?"
aw codex '{"type": "something-else"}' 54
ok test ! -e "$t/state/vikix/agents/54"
# Outside a terminal window: nothing.
n=$(find "$t/state/vikix/agents" -type f | wc -l)
echo '{}' | env -u ALACRITTY_WINDOW_ID "$here/bin/agent-waiting" permission
ok test "$(find "$t/state/vikix/agents" -type f | wc -l)" = "$n"
ok test -z "$(find "$t/state/vikix/agents" -name '*.new')"
# The desktop was told, each time a note changed.
sleep 0.5
ok grep -qx 'eval (agent-waiting-changed)' "$t/told"
ok test "$(wc -l < "$t/told")" -ge 10
ok test -n "$(stamp 49)"

mkdir -p "$t/.claude"
echo '{"theme": "dark", "hooks": {"Stop": [{"hooks": [{"type": "command", "command": "mine"}]}], "Notification": [{"hooks": [{"type": "command", "command": "'"$t"'/.local/bin/agent-waiting ask"}]}]}}' > "$t/.claude/settings.json"
"$here/setup" >/dev/null; "$here/setup" >/dev/null
ok test "$(grep -c 'agent-waiting' "$t/.claude/settings.json")" = 5     # the one that was there isn't added again
ok grep -q '"matcher": "AskUserQuestion"' "$t/.claude/settings.json"
ok grep -q 'agent-waiting permission' "$t/.claude/settings.json"
ok grep -q '"mine"' "$t/.claude/settings.json"
ok grep -q '"theme": "dark"' "$t/.claude/settings.json"
"$here/remove" >/dev/null
ok test "$(grep -c 'agent-waiting' "$t/.claude/settings.json")" = 0
ok grep -q '"mine"' "$t/.claude/settings.json"
ok test ! -e "$t/state/vikix/agents"

# Codex: the notify setting goes before the first table, once; what was
# there stays; remove takes it out; one of your own is left; no ~/.codex,
# nothing made.
mkdir -p "$t/.codex"
printf 'model = "m"\n\n[tui]\nnotifications = true\n' > "$t/.codex/config.toml"
"$here/setup" >/dev/null; "$here/setup" >/dev/null
ok test "$(grep -c '^notify = ' "$t/.codex/config.toml")" = 1
ok test "$(python3 -c "import tomllib,sys;c=tomllib.load(open(sys.argv[1],'rb'));print(c['notify'][1], c['model'], c['tui']['notifications'])" "$t/.codex/config.toml")" = "codex m True"
ok grep -q "agent-waiting\", \"codex\"" "$t/.codex/config.toml"
"$here/remove" >/dev/null
ok test "$(grep -c 'agent-waiting' "$t/.codex/config.toml")" = 0
ok test "$(cat "$t/.codex/config.toml")" = "$(printf 'model = "m"\n\n[tui]\nnotifications = true')"
printf 'notify = ["mine"]\n' > "$t/.codex/config.toml"
case $("$here/setup") in *"notify setting of its own"*) ;; *) echo "FAIL: setup says a notify of your own is left"; fail=1 ;; esac
ok test "$(cat "$t/.codex/config.toml")" = 'notify = ["mine"]'
"$here/remove" >/dev/null
ok test "$(cat "$t/.codex/config.toml")" = 'notify = ["mine"]'
rm -rf "$t/.codex"
"$here/setup" >/dev/null
ok test ! -e "$t/.codex"
exit "$fail"
